<% card = 'rounded-xl border border-n-weak bg-n-solid-1 p-5 space-y-4' %>
<% help = 'text-label-small text-n-slate-11' %>
<%= form_with url: super_admin_domli_ai_writing_assistant_path, method: :patch, class: card do |form| %>
  <h2 class="text-heading-2 text-n-slate-12"><%= t('super_admin.domli_ai.writing_title') %></h2>
  <p class="text-body-main text-n-slate-12"><%= t('super_admin.domli_ai.writing_help') %></p>
  <p class="<%= help %>">
    <% if writing_key_set? %>
      <%= t('super_admin.domli_ai.writing_key_ok') %>
    <% else %>
      <%= t('super_admin.domli_ai.writing_key_missing') %>
    <% end %>
    <%= link_to t('super_admin.domli_ai.writing_key_link'), super_admin_app_config_path(config: 'captain'), class: "underline" %>
  </p>

  <ul class="divide-y divide-n-weak">
    <% writing_customers.each do |account| %>
      <li class="flex items-center justify-between gap-3 py-3">
        <div class="min-w-0">
          <p class="truncate text-body-main font-medium text-n-slate-12"><%= account.name %></p>
          <p class="text-label-small text-n-slate-11">#<%= account.id %></p>
        </div>
        <%= hidden_field_tag "writing_assistant[#{account.id}]", 'false', id: nil %>
        <label class="flex items-center gap-2 text-body-main text-n-slate-12">
          <%= check_box_tag "writing_assistant[#{account.id}]", 'true', account.feature_enabled?(SuperAdmin::DomliAiController::WRITING_FLAG), id: "writing_assistant_#{account.id}", class: ui(:checkbox) %>
          <%= t('super_admin.domli_ai.writing_enabled') %>
        </label>
      </li>
    <% end %>
  </ul>

  <p class="<%= help %>"><%= t('super_admin.domli_ai.writing_scope_note') %></p>
  <p class="<%= help %>"><%= t('super_admin.domli_ai.writing_cost_note') %></p>
  <%= render "button", label: t('super_admin.domli_ai.save'), submit: form %>
<% end %>
