<%# locals: (customer_id:) -%>
<% card = 'rounded-xl border border-n-weak bg-n-solid-1 p-5 space-y-4' %>
<% h2 = 'text-heading-2 text-n-slate-12' %>
<% help = 'text-label-small text-n-slate-11' %>
<% label = 'text-label text-n-slate-12' %>

<%= form_with url: super_admin_domli_ai_path, method: :patch, class: card do |form| %>
  <%= form.hidden_field :account_id, value: customer_id %>
  <%= form.hidden_field :tab, value: 'behavior' %>
  <%= hidden_field_tag :languages_submitted, '1', id: nil %>
  <h2 class="<%= h2 %>"><%= t('super_admin.domli_ai.behavior_title') %></h2>
  <p class="<%= help %>"><%= t('super_admin.domli_ai.behavior_help') %></p>

  <div class="grid gap-3 sm:grid-cols-2">
    <div>
      <%= label_tag :business_name, t('super_admin.domli_ai.business_name'), class: label %>
      <%= text_field_tag :business_name, @bot_account['businessName'], maxlength: 100, class: ui(:input) %>
    </div>
    <div>
      <%= label_tag :assistant_name, t('super_admin.domli_ai.assistant_name'), class: label %>
      <%= text_field_tag :assistant_name, @bot_account['assistantName'], maxlength: 40, class: ui(:input) %>
      <p class="<%= help %>"><%= t('super_admin.domli_ai.assistant_name_help') %></p>
    </div>
  </div>

  <div>
    <p class="<%= label %>"><%= t('super_admin.domli_ai.languages') %></p>
    <div class="mt-1 flex flex-wrap gap-4">
      <% %w[nl en].each do |code| %>
        <label class="flex items-center gap-2 text-body-main text-n-slate-12">
          <%= check_box_tag 'languages[]', code, @bot_account['languages'].include?(code), id: "languages_#{code}", class: ui(:checkbox) %>
          <%= t("super_admin.domli_ai.language_#{code}") %>
        </label>
      <% end %>
    </div>
    <p class="<%= help %>"><%= t('super_admin.domli_ai.languages_help') %></p>
  </div>

  <div>
    <%= label_tag :unknown_behavior, t('super_admin.domli_ai.unknown_behavior'), class: label %>
    <%= select_tag :unknown_behavior, options_for_select([[t('super_admin.domli_ai.unknown_handoff'), 'handoff'], [t('super_admin.domli_ai.unknown_say_unknown'), 'say_unknown']], @bot_account['unknownBehavior']), class: ui(:select) %>
    <p class="<%= help %>"><%= t('super_admin.domli_ai.unknown_help') %></p>
  </div>

  <div>
    <%= label_tag :instructions, t('super_admin.domli_ai.instructions_title'), class: label %>
    <p class="<%= help %>"><%= t('super_admin.domli_ai.instructions_help') %></p>
    <%= text_area_tag :instructions, @bot_account['instructions'], rows: 8, maxlength: 2000, placeholder: t('super_admin.domli_ai.instructions_placeholder'), class: ui(:input) %>
  </div>

  <div class="grid gap-3 sm:grid-cols-2">
    <div>
      <%= label_tag :handoff_message_nl, t('super_admin.domli_ai.handoff_message_nl'), class: label %>
      <%= text_area_tag :handoff_message_nl, @bot_account['handoffMessage']['nl'], rows: 3, maxlength: 1000, class: ui(:input) %>
    </div>
    <div>
      <%= label_tag :handoff_message_en, t('super_admin.domli_ai.handoff_message_en'), class: label %>
      <%= text_area_tag :handoff_message_en, @bot_account['handoffMessage']['en'], rows: 3, maxlength: 1000, class: ui(:input) %>
    </div>
  </div>
  <p class="<%= help %>"><%= t('super_admin.domli_ai.handoff_message_help') %></p>

  <details class="rounded-lg border border-n-weak p-3">
    <summary class="cursor-pointer text-label text-n-slate-12"><%= t('super_admin.domli_ai.advanced') %></summary>
    <div class="mt-3 space-y-4">
      <div>
        <%= label_tag :model, t('super_admin.domli_ai.model_override'), class: label %>
        <%= text_field_tag :model, @bot_account['model'], placeholder: @settings['model'], class: ui(:input) %>
        <p class="<%= help %>"><%= t('super_admin.domli_ai.model_override_help') %></p>
      </div>
      <div>
        <%= label_tag :prompt_template, t('super_admin.domli_ai.base_rules'), class: label %>
        <p class="<%= help %>"><%= t('super_admin.domli_ai.base_rules_help') %></p>
        <%= text_area_tag :prompt_template, @bot_account['promptTemplate'], rows: 14, maxlength: 6000, class: ui(:input, "font-mono text-xs") %>
        <label class="mt-2 flex items-center gap-2 text-body-main text-n-slate-12">
          <%= check_box_tag :reset_prompt_template, '1', false, class: ui(:checkbox) %>
          <%= t('super_admin.domli_ai.reset_base_rules') %>
        </label>
      </div>
    </div>
  </details>

  <%= render "button", label: t('super_admin.domli_ai.save'), submit: form %>
<% end %>
