<% content_for(:title) { t('super_admin.domli_ai.title') } %>

<%= render "section", title: t('super_admin.domli_ai.title'), description: t('super_admin.domli_ai.description'), icon: 'i-lucide-bot' do %>
  <% if !@configured %>
    <%= render "alert" do %><%= t('super_admin.domli_ai.not_configured') %><% end %>
  <% elsif @error %>
    <%= render "alert" do %><%= @error %><% end %>
  <% else %>
    <% customer_id = @customer&.id %>
    <%= render "super_admin/domli_ai/tabs", customer_id: customer_id %>

    <% if current_tab == 'global' %>
      <%= render "super_admin/domli_ai/global", customer_id: customer_id %>
    <% elsif @customer.nil? %>
      <%= render "alert" do %><%= t('super_admin.domli_ai.no_accounts') %><% end %>
    <% else %>
      <% enabled_ids = @bot_accounts.select { |a| a['enabled'] }.map { |a| a['id'] } %>
      <%= form_with url: super_admin_domli_ai_path, method: :get, class: "flex items-end gap-3" do |form| %>
        <%= form.hidden_field :tab, value: current_tab %>
        <div class="min-w-0 flex-1">
          <%= form.label :account_id, t('super_admin.domli_ai.customer'), class: "text-label text-n-slate-12" %>
          <%= form.select :account_id, @customers.map { |a| ["#{a.name} (##{a.id})#{' ✓' if enabled_ids.include?(a.id.to_s)}", a.id] }, { selected: customer_id }, class: ui(:select) %>
        </div>
        <%= render "button", label: t('super_admin.domli_ai.show'), variant: :secondary, submit: form %>
      <% end %>

      <% if @bot_account.nil? %>
        <%= render "super_admin/domli_ai/setup", customer_id: customer_id %>
      <% else %>
        <%= render "super_admin/domli_ai/#{current_tab}", customer_id: customer_id %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
