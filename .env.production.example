# Domli production environment. Copy to .env (git-ignored). Never commit real values.
DOMLI_IMAGE=ghcr.io/majidelmehammedy/domli:latest

# Generate: openssl rand -hex 64
SECRET_KEY_BASE=
FRONTEND_URL=https://app.domli.nl
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=nl
DISABLE_TELEMETRY=true

POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=chatwoot_production
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# Encrypt stored channel credentials (generate with: bundle exec rails db:encryption:init)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Outgoing email (use an EU provider, list it as a subprocessor)
MAILER_SENDER_EMAIL=Domli <noreply@domli.nl>
SMTP_DOMAIN=domli.nl
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

ACTIVE_STORAGE_SERVICE=local
LOG_LEVEL=info

# Domli AI: lets the super admin page manage the assistant (instructions, knowledge, on/off).
# DOMLI_BOT_ADMIN_TOKEN must equal the ADMIN_TOKEN in domli-bot/.env. Default URL is http://bot:3100.
DOMLI_BOT_ADMIN_TOKEN=
# DOMLI_BOT_URL=http://bot:3100
