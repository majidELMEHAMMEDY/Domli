# Port the bot listens on
PORT=3100

# Secret path segment: configure the Chatwoot agent bot outgoing URL as
#   https://bot.domli.nl/webhook/<BOT_WEBHOOK_SECRET>
BOT_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Base URL of the Chatwoot app (internal URL is fine inside docker)
CHATWOOT_URL=http://rails:3000

# Claude API key. Stays on the server, never in the repo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Per-account settings (enabled, mode, caps, tokens) live in this JSON file
ACCOUNTS_FILE=./data/accounts.json
# Per-account knowledge (FAQ) as markdown files: <KNOWLEDGE_DIR>/<accountId>.md
KNOWLEDGE_DIR=./knowledge
# Usage counters and token log
DATA_DIR=./data
